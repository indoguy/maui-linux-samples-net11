<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Auto-import OpenMaui targets for all sample projects on Linux.
       Only applies to local development with a sibling maui-linux checkout;
       package-reference builds get their targets from the NuGet package. -->
  <PropertyGroup>
    <_OpenMauiLocalTargets>$(MSBuildThisFileDirectory)../maui-linux/build/OpenMaui.Controls.Linux.targets</_OpenMauiLocalTargets>
  </PropertyGroup>
  <Import Project="$(_OpenMauiLocalTargets)" Condition="$([MSBuild]::IsOSPlatform('Linux')) AND Exists('$(_OpenMauiLocalTargets)')" />
</Project>
